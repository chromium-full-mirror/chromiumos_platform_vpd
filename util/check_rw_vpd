#
# Checks if the VPD can be read and if the contents match the data from
# dump_vpd_log. Send the results to UMA. The script has no input arguments.
#
# Supposed to run after the boot is done.
#
# Depends on dump_vpd_log script, specifically for the format of the output.

send_uma_result() {
  metrics_client -s Enterprise.VpdCheck "$1" &
}

#
# main()
#

renice -n 19 $$

SUCCESS=0
CONTENT_MISMATCH=256
EMPTY_VPD=257
EMPTY_DUMP_VPD=258
EMPTY_RW_VPD=259

# Documented VPD keys.
# https://www.google.com/chromeos/partner/fe/docs/factory/vpd.html
DOCUMENTED_VPD_KEYS="
  ActivateDate
  block_devmode
  check_enrollment
  first_active_omaha_ping_sent
  gbind_attribute
  ubind_attribute"

# Undocumented but well-known VPD keys. Keeping those for the time being.
UNDOCUMENTED_VPD_KEYS="
  BIOS
  BTMac
  BT_MAC
  MACAddress
  System_UUID
  WiFiMac
  WLANID"

# Deprecated VPD keys. Will be deleted eventually.
DEPRECATED_VPD_KEYS="
  FCT1Finished
  injection_date
  Main
  mlb_serial_number
  recovery_count"

# Read from RW_VPD.
vpd_rw_output="$(vpd -i RW_VPD -l)"
read_status=$?
if [ "${read_status}" != 0 ]; then
  send_uma_result "${read_status}"
  exit "${read_status}"
fi

# Report unknown RW_VPD keys.
unknown_count=0
while IFS="=" read -r key remainder; do
  local found=0
  for known_key in ${DOCUMENTED_VPD_KEYS} ${UNDOCUMENTED_VPD_KEYS} \
      ${DEPRECATED_VPD_KEYS}; do
    if [ "${key}" = "\"${known_key}\"" ]; then
      found=1
      break
    fi
  done
  if [ "${found}" != 1 ]; then
    : $(( unknown_count += 1 ))
  fi
done << EOF
${vpd_rw_output}
EOF
metrics_client -e Platform.Vpd.UnknownKeys "${unknown_count}" 10

# Compare RW_VPD contents against dump_vpd_log output.
dump_vpd_output="$(dump_vpd_log --stdout --full)"
if [ -z "${dump_vpd_output}" ] && [ -z "${vpd_rw_output}" ]; then
  send_uma_result "${EMPTY_VPD}"
elif [ -z "${dump_vpd_output}" ]; then
  send_uma_result "${EMPTY_DUMP_VPD}"
elif [ -z "${vpd_rw_output}" ]; then
  send_uma_result "${EMPTY_RW_VPD}"
elif [ -z "${dump_vpd_output##*$vpd_rw_output}" ]; then
  send_uma_result "${SUCCESS}"
else
  send_uma_result "${CONTENT_MISMATCH}"
fi
